# --- Lina — inbound real-estate secretary (Viber first, TG/WA later) ---
#
# IMPORTANT: this is a TEMPLATE only. Copy the values you need into ~/.lina/lina.env
# (mkdir -p ~/.lina, chmod 600) — Lina's OWN key store, separate from ANA's
# ~/.ana/ana.env. Do NOT create a .env* file in the project directory — a .env file in
# the project CWD crashes the Freebuff CLI terminal broker (its --env-file loader
# requires Node >= 20.6; this machine runs Node 18.20).
#
# Load order at boot: real process env (pm2/systemd) > ~/.lina/lina.env
PORT=8080

# --- LLM: Gemini primary, Groq fallback ---
# llmProvider: hybrid (gemini → groq failover, default) | gemini | groq
LLM_PROVIDER=hybrid

# --- Gemini (primary) ---
GEMINI_API_KEY=
# Optional 2nd Gemini key from ANOTHER Google project — each project has its own
# quota, so requests rotate round-robin across both keys (doubles daily capacity).
GEMINI_API_KEY_2=
# Optional 3rd Gemini key from ANOTHER Google project — rotates round-robin with
# the keys above (triples daily capacity).
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_CLASSIFY=gemini-3.6-flash

# --- Groq (fallback) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_CLASSIFY=llama-3.1-8b-instant

PERSONA_TEMP=1.2
CLASSIFY_TEMP=0.2
TOP_P=0.95
MAX_TOKENS=1024

# --- Property source (Supabase edge function) ---
PROPERTY_DATA_URL=https://qkgioqotxjxffiaufgwd.supabase.co/functions/v1/public-properties?format=json
# Customers' public property pages. The feed gives only a relative /property/<uuid>
# path — this is prepended so Lina sends a clickable full link. Currently the
# Lovable app; switch to the Cloudflare URL after the migration.
PUBLIC_SITE_URL=https://preview--home-scan-search.lovable.app

# --- Viber ---
VIBER_TOKEN=
# Public HTTPS URL of the machine, e.g. https://your-domain or ngrok tunnel
VIBER_WEBHOOK_URL=
VIBER_SENDER_NAME=Lina

# --- Store / sessions ---
DB_PATH=data/lina.db
CHAT_TTL_MINUTES=60
MAX_HISTORY=20
MONTHLY_INITIATED_LIMIT=9500

# --- Human pacing (Viber has no typing indicator) ---
MIN_DELAY_MS=800
MAX_DELAY_MS=2200

# --- TUI typing windows ---
# Owner "typing" window: after /owner, Lina waits this long before relaying
# (follow-up /owner messages reset it, Enter bypasses).
OWNER_TYPING_DELAY_MS=30000
# Client "typing" window: after the client sends a message, Lina waits this long
# before replying — follow-up messages reset it, Enter flushes immediately.
CLIENT_TYPING_DELAY_MS=30000

# --- Simulator ---
# true = no pacing inside the fake channel (CI / fast runs)
SIM_FAST=false
