# --- Lina — inbound real-estate secretary (Viber first, TG/WA later) ---
#
# IMPORTANT: this is a TEMPLATE only. Copy the values you need into ~/.lina/lina.env
# (mkdir -p ~/.lina, chmod 600) — Lina's OWN key store, separate from ANA's
# ~/.ana/ana.env. Do NOT create a .env* file in the project directory — a .env file in
# the project CWD crashes the Freebuff CLI terminal broker (its --env-file loader
# requires Node >= 20.6; this machine runs Node 18.20).
#
# Load order at boot: real process env (pm2/systemd) > ~/.lina/lina.env
PORT=8080

# --- LLM: Gemini primary, Groq fallback ---
# llmProvider: hybrid (gemini → groq failover, default) | gemini | groq
LLM_PROVIDER=hybrid

# --- Gemini (primary) ---
GEMINI_API_KEY=
# Optional 2nd Gemini key from ANOTHER Google project — each project has its own
# quota, so requests rotate round-robin across both keys (doubles daily capacity).
GEMINI_API_KEY_2=
# Optional 3rd Gemini key from ANOTHER Google project — rotates round-robin with
# the keys above (triples daily capacity).
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL_CLASSIFY=gemini-3.6-flash

# --- Groq (fallback) ---
# 2026-08-16: llama-3.3-70b-versatile and llama-3.1-8b-instant are deprecated
# (free/developer tier). qwen/qwen3.6-27b is the small/fast pick so the 100k/day
# free quota stays usable; openai/gpt-oss-120b is the stronger (reasoning-heavy)
# alternative. Classify has only one listed replacement: openai/gpt-oss-20b.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_MODEL_CLASSIFY=openai/gpt-oss-20b

PERSONA_TEMP=1.2
CLASSIFY_TEMP=0.2
TOP_P=0.95
MAX_TOKENS=1024

# --- Property source (Supabase edge function) ---
PROPERTY_DATA_URL=https://qkgioqotxjxffiaufgwd.supabase.co/functions/v1/public-properties?format=json
# Customers' public property pages. The feed gives only a relative /property/<uuid>
# path — this is prepended so Lina sends a clickable full link. Currently the
# Lovable app; switch to the Cloudflare URL after the migration.
PUBLIC_SITE_URL=https://preview--home-scan-search.lovable.app

# --- Viber ---
VIBER_TOKEN=
# Public HTTPS URL of the machine, e.g. https://your-domain or ngrok tunnel
VIBER_WEBHOOK_URL=
VIBER_SENDER_NAME=Lina

# --- Store / sessions ---
DB_PATH=data/lina.db
CHAT_TTL_MINUTES=60
MAX_HISTORY=20
MONTHLY_INITIATED_LIMIT=9500

# --- Hermes offline map (T60 plan) ---
# Local OSM map of Skopje (named POIs + addresses, a few MB in SQLite) that the
# landmark resolver reads instead of live Nominatim/Overpass — zero geo API
# calls on the hot path. Built by `npm run map:pull` (cron: Sunday 03:17 via
# scripts/skopje-map-weekly.sh). Live APIs stay as the fallback when the map is
# missing or a street/ring is unmatched. Default: data/skopje-pois.db
SKOPJE_POIS_DB=

# --- Hermes (landmarks → public app feed) ---
# The ranked landmark list ("во близина на …" answers) is resolved at ANA's
# import and stored NEXT TO the property in Supabase via this private edge
# function (update-property-landmarks, same x-admin-token guard). Lina then
# just READS the `landmarks` field from the feed — zero network, zero key, zero
# cron. The resolver (npm run hermes:landmarks -- --feed) is the backfill tool.
HERMES_LANDMARKS_WRITE_URL=

# --- Hermes (price sync to the public app) ---
# Hermes reads owner-dictated price changes from DB_PATH (price_changes table)
# and POSTs them to a private Supabase edge function that Lovable builds
# (updates the property price in the app's own DB, with validation + audit).
# Missing URL/token = Hermes runs in dry-run/report mode (never a silent no-op).
HERMES_WRITE_URL=
HERMES_TOKEN=
# Request header carrying the token; must match the edge function's check.
HERMES_AUTH_HEADER=x-admin-token

# --- Address privacy: approximate locations (landmarks) ---
# The exact street is NEVER shown to clients (they'd bypass the agency). Lina
# answers "каде се наоѓа?" with a nearby public landmark. Resolution layers:
# deterministic per-neighborhood table (always) -> Google (only with this key,
# free tier covers ~40k geocodes/month) -> OSM (free, no key) -> Hermes event.
# Leave empty to skip the Google layer.
GOOGLE_MAPS_API_KEY=
# Agency operator's Viber id — the visit-protocol operator log goes here
# (plus the TUI and the events table).
VIBER_OPERATOR_ID=

# --- Hermes' own reasoning LLM (NVIDIA NIM, OpenAI-compatible) ---
# The landmark resolver (npm run hermes:landmarks) uses Hermes' own brain —
# free tier, separate from Lina's Gemini/Groq quota — to name the NEAREST
# public place for each property address ("во близина на Кафе бар Ван Гог").
HERMES_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
HERMES_LLM_API_KEY=
HERMES_LLM_MODEL=meta/llama-3.1-8b-instruct
# --- Two-machine bridge (Hermes on its own box) ---
# Lina serves the token-guarded /hermes/v1 API on the same :8080 server; the
# Hermes machine calls it with LINA_API_URL + the shared HERMES_TOKEN. When
# LINA_API_URL is set, the hermes/hermes:landmarks scripts run REMOTE (pull
# work, push results) instead of reading the local DB.
LINA_API_URL=
# How often the owner agent polls the events bus for a Hermes answer (ms).
OWNER_BUS_POLL_MS=2000

# --- Human pacing (Viber has no typing indicator) ---
MIN_DELAY_MS=800
MAX_DELAY_MS=2200

# --- TUI typing windows ---
# Owner "typing" window: after /owner, Lina waits this long before relaying
# (follow-up /owner messages reset it, Enter bypasses).
OWNER_TYPING_DELAY_MS=30000
# Client "typing" window: after the client sends a message, Lina waits this long
# before replying — follow-up messages reset it, Enter flushes immediately.
CLIENT_TYPING_DELAY_MS=30000

# --- Simulator ---
# true = no pacing inside the fake channel (CI / fast runs)
SIM_FAST=false
